# Copy to .env.local (never committed) and fill in what you want. All optional.

# ESV text via the official ESV API (free for non-commercial use): https://api.esv.org/
# Without it, English verses come from the bundled World English Bible / KJV.
ESV_API_KEY=

# Machine translation is ONLY a labelled fallback for words not in your lists.
# Runs locally with Ollama (free, private — sermon text never leaves your computer).
# Best for Korean:  ollama pull exaone3.5:7.8b   (picked automatically once installed)
MT_PROVIDERS=ollama
OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=exaone3.5:7.8b
# LIBRETRANSLATE_URL=http://localhost:5000/translate   (add ",libretranslate" to MT_PROVIDERS)

# PORT=5173
