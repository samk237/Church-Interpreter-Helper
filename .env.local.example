# Copy to .env.local (never committed) and fill in what you want. All optional.

# ESV text via the official ESV API (free for non-commercial use): https://api.esv.org/
# Without it, English verses come from the bundled World English Bible / KJV.
ESV_API_KEY=

# Machine-translation fallback order for words NOT in your lists.
# ollama = local LLM (free, private); mymemory = free web API; libretranslate = your own instance
MT_PROVIDERS=ollama,mymemory
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
# LIBRETRANSLATE_URL=http://localhost:5000/translate

# PORT=5173
