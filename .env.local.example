# Copy to .env.local (never committed) and fill in what you want. All optional.
# Used by the Mac server (npm start / npm run phone). The website gets these via npm run web:setup.

# ESV text via the official ESV API (free for non-commercial use): https://api.esv.org/
# Without it, English verses come from the bundled World English Bible.
ESV_API_KEY=

# Cloud AI for words not in your lists (better Korean + Korean "did you mean" guesses).
# Free key: https://aistudio.google.com/apikey  (free tier: Google may use what you look up to improve its products)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional, paid: Anthropic Claude (https://platform.claude.com) — highest quality, fractions of a cent per lookup.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Order to try (only configured ones are used). ollama = the free local model on this Mac.
# AI_PROVIDERS=gemini,claude,ollama
# OLLAMA_MODEL=exaone3.5:7.8b

# PORT=5173
